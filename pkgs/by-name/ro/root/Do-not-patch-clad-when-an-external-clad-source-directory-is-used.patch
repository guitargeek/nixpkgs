Do not patch clad when an external clad source directory is used

An external clad source directory passed via CLAD_SOURCE_DIR is expected
to be already patched if necessary. It might also be read-only or not a
git repository, in which case the patch step with git checkout and git
apply fails. So skip the patch step in this case.

---
diff --git a/interpreter/cling/tools/plugins/clad/CMakeLists.txt b/interpreter/cling/tools/plugins/clad/CMakeLists.txt
index 48aea31eec7..2bf9b3d3b8f 100644
--- a/interpreter/cling/tools/plugins/clad/CMakeLists.txt
+++ b/interpreter/cling/tools/plugins/clad/CMakeLists.txt
@@ -100,7 +100,10 @@ endif()
 # list(APPEND _clad_patches_list "patch1.patch" "patch2.patch")
 #list(APPEND _clad_patches_list "nullptr_dereference_fix.patch" "windows_build_fix.patch")
 list(APPEND _clad_patches_list "lld_lookup_no_default_path.patch")
-if (_clad_patches_list)
+# An external clad source directory is used as is: it is expected to be
+# already patched if necessary, and it might be read-only or not a git
+# repository, so the patches cannot be applied to it anyway.
+if (_clad_patches_list AND NOT DEFINED CLAD_SOURCE_DIR)
   set(_clad_patch_command
       ${CMAKE_COMMAND} -E copy_directory
       ${CMAKE_SOURCE_DIR}/interpreter/cling/tools/plugins/clad/patches <SOURCE_DIR>
